Table sessions {
  id            varchar(255) [pk]
  user_id       char(36)     [null]
  ip_address    varchar(45)  [null]
  user_agent    text         [null]
  payload       longtext     [not null]
  last_activity integer      [not null]

  Indexes {
    user_id
    last_activity
  }

  Note: '''
  Laravel framework table. Indexed on user_id, no foreign key constraint.

  The active fiscal mode lives in this payload. It must NOT live in browser
  localStorage: the backend has to stamp fiscal_mode onto every project,
  invoice, PO and journal entry, and a client-controlled tax context on a
  financial ledger is not trustworthy.
  '''
}

Ref: sessions.user_id > users.id
