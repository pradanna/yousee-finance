Table tax_settlements {
  id                 uuid          [pk, default: `gen_random_uuid()`]
  month              tinyint       [not null, note: '1..12']
  year               smallint      [not null]
  fiscal_mode        varchar(255)  [not null, default: 'ppn', note: 'ppn | non-ppn']
  ntpn               varchar(16)   [not null, note: 'Nomor Transaksi Penerimaan Negara (16 digit alfanumerik)']
  paid_date          date          [not null]
  bank_name          varchar(255)  [not null]
  ppn_keluaran_total decimal(15,2) [not null, default: 0]
  ppn_masukan_total  decimal(15,2) [not null, default: 0]
  net_amount         decimal(15,2) [not null, default: 0]
  status             varchar(50)   [not null, default: 'paid', note: 'paid | unpaid | compensated']
  notes              text          [null]
  created_by         char(36)      [null, note: 'users.id']
  created_at         timestamp     [null]
  updated_at         timestamp     [null]

  Indexes {
    (month, year, fiscal_mode) [unique]
  }

  Note: '''
  Domain: Accounting
  Model: App\Domains\Accounting\Models\TaxSettlement

  Records tax settlement / NTPN payment to the state treasury per tax period.
  '''
}

Ref: tax_settlements.created_by > users.id
