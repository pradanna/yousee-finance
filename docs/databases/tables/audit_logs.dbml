Table audit_logs {
  id varchar(36) [pk, note: 'UUID Primary Key']
  auditable_type varchar(255) [not null, note: 'Polymorphic Model Class (e.g., App\\Domains\\Accounting\\Models\\CashTransaction)']
  auditable_id varchar(36) [not null, note: 'Polymorphic Model UUID']
  event varchar(50) [not null, note: 'Jenis aktivitas: created, updated, voided, deleted']
  user_id varchar(36) [null, ref: > users.id, note: 'User pelaku aktivitas']
  description text [null, note: 'Deskripsi ringkas aktivitas']
  properties json [null, note: 'Detail payload / metadata aktivitas (alasan, snapshot data)']
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Tabel sentral jejak audit (Audit Trail) aktivitas transaksi keuangan'
}
